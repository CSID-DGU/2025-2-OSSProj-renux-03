{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dongttok.local/schemas/golden-run-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_version", "run_id", "run_started_at", "run_completed_at", "endpoint", "endpoint_ready_status", "endpoint_ready_payload_hash", "header_names", "matrix_sha256", "taxonomy_version", "taxonomy_sha256", "results_sha256", "result_count", "expected_result_count", "selected_case_ids", "complete", "failed_case_ids", "git", "candidate_config", "data_manifest_hash", "data_files"],
  "properties": {
    "schema_version": {"const": 1},
    "runner_version": {"const": "real-http-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "run_completed_at": {"type": "string", "format": "date-time"},
    "endpoint": {"type": "string", "format": "uri"},
    "endpoint_ready_status": {"type": "integer", "minimum": 0, "maximum": 599},
    "endpoint_ready_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "header_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taxonomy_version": {"const": "student-domain-app-intent-v1"},
    "taxonomy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_count": {"type": "integer", "minimum": 0},
    "expected_result_count": {"type": "integer", "minimum": 160},
    "selected_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "complete": {"type": "boolean"},
    "failed_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_sha", "dirty", "diff_sha256"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|unavailable)$"},
        "dirty": {"type": "boolean"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate_config": {
      "type": "object", "additionalProperties": false,
      "required": ["llm_provider", "query_analysis_model", "answer_model", "embedding_model", "embedding_revision", "reranker_enabled", "reranker_model", "top_k"],
      "properties": {
        "llm_provider": {"type": "string", "minLength": 1},
        "query_analysis_model": {"type": "string", "minLength": 1},
        "answer_model": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1},
        "embedding_revision": {"type": ["string", "null"]},
        "reranker_enabled": {"type": "boolean"},
        "reranker_model": {"type": ["string", "null"]},
        "top_k": {"type": "integer", "minimum": 1}
      }
    },
    "data_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
